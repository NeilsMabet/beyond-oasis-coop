+    for (s=0; s<4; s++) saved.CH[c].SLOT[s].DT = NULL;
+    saved.CH[c].connect1 = saved.CH[c].connect2 = NULL;
+    saved.CH[c].connect3 = saved.CH[c].connect4 = NULL;
+    saved.CH[c].mem_connect = NULL;
+  }
+  save_param(&saved, sizeof(saved));
 
   /* save DT table index for each channel slots */
   for (c=0; c<6; c++)
